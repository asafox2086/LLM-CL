[Unit]
Description=OneVision inherited-basis and update-budget causal control
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data1/liyapeng/program/LLMCL
Environment=CUDA_VISIBLE_DEVICES=1
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
ExecStart=/usr/bin/nohup /data1/liyapeng/program/LLMCL/.vision-env/bin/python -u /data1/liyapeng/program/LLMCL/analysis/onevision_basis_budget_probe.py
StandardInput=null
StandardOutput=append:/data1/liyapeng/program/LLMCL/summary/onevision_diagnostics_20261016/basis_budget/coordinator_nohup.log
StandardError=inherit
Restart=no

[Install]
WantedBy=default.target
