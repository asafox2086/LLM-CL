[Unit]
Description=Read-only learned cosine reuse evidence observer
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/data1/liyapeng/program/LLMCL
Environment=CUDA_VISIBLE_DEVICES=
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/nohup /data1/liyapeng/program/LLMCL/.assets-env/bin/python -u /data1/liyapeng/program/LLMCL/analysis/onevision_learned_reuse_report.py --watch
StandardInput=null
StandardOutput=append:/data1/liyapeng/program/LLMCL/summary/onevision_diagnostics_20261016/learned_reuse/observer_nohup.log
StandardError=inherit
Restart=no
KillMode=process
[Install]
WantedBy=default.target
