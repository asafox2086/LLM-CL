[Unit]
Description=Controlled OneVision capped reuse after deterministic native reference
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data1/liyapeng/program/LLMCL
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/usr/bin/nohup /data1/liyapeng/program/LLMCL/.vision-env/bin/python -u /data1/liyapeng/program/LLMCL/analysis/onevision_capacity_queue.py
StandardInput=null
StandardOutput=append:/data1/liyapeng/program/LLMCL/summary/onevision_diagnostics_20261016/capacity/coordinator_nohup.log
StandardError=inherit
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
