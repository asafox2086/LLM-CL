[Unit]
Description=GPU1 causal diagnostic priority after unchanged active full confirmation
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/data1/liyapeng/program/LLMCL
Environment=CUDA_VISIBLE_DEVICES=
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/nohup /data1/liyapeng/program/LLMCL/.assets-env/bin/python -u /data1/liyapeng/program/LLMCL/analysis/onevision_causal_priority_queue.py
StandardInput=null
StandardOutput=append:/data1/liyapeng/program/LLMCL/summary/onevision_diagnostics_20261016/causal_priority_queue/coordinator_nohup.log
StandardError=inherit
Restart=no
KillMode=process
[Install]
WantedBy=default.target
